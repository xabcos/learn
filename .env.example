PUBLIC_BASE_URL=http://127.0.0.1:8788
# false: serve the pages only; `learn write` still writes one lesson on demand.
LEARN_WRITER=false
AI_BASE_URL=https://api.zairouter.com
AI_API_KEY=
AI_MODEL=gpt-6-astra
AI_IMAGE_MODEL=gpt-image-2.5-flare
TMPFILE_BASE_URL=https://dl.xabcnews.com
TMPFILE_API_KEY=
